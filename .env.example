# Public browser-safe values. Local defaults are printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
CRON_SHARED_SECRET=
RATE_LIMIT_HASH_SECRET=

# Application defaults
APP_TIMEZONE=Asia/Bangkok
APP_CURRENCY=THB
DEFAULT_TENANT_SLUG=baan-mhor-poy

# Used only by `npm run owner:invite`; it is optional during build/test.
INITIAL_OWNER_EMAIL=

# Used only by opt-in database integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used only to stage reviewed migration rehearsal metadata. Never expose to browser code.
MIGRATION_DATABASE_URL=
